# JARVIS .gitignore

# Backups/artefatos temporários
/Snapshots/
/_latest

# Logs
/Logs/

# Python
__pycache__/
*.pyc
*.pyo

# Sistema / Windows
Thumbs.db
Desktop.ini
*.lnk
*.regtrans-ms
NTUSER.DAT*
ntuser.*

# Dependências e ambientes
.venv/
venv/
.env
.env.local

# Editores
.vscode/
.idea/
*.swp
*.swo

# Node (se usar)
node_modules/

# Git
.git/

# Geradores externos (não versionar saídas)
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mp3
*.wav
/Downloads/

# JARVIS: versionar graph, ignorar só artefactos temporários
Learnings/KnowledgeGraph/*.tmp.jsonl
Learnings/KnowledgeGraph/*.bak.jsonl
Imports/**/*.tmp

# Configs sensíveis
Config/openrouter.json
